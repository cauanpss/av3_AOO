;&quot;&gt;VARCHAR(11)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;11 dígitos; CPF válido&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;UNIQUE; NOT NULL; validar dígitos verificadores; dado pessoal LGPD.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Pessoa — cpf; RF01&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;email&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;VARCHAR(150)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Endereço de e-mail válido&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;UNIQUE; NOT NULL; normalizar para minúsculas; usado em notificações.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Pessoa — email; RF05&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;telefone&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;VARCHAR(20)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Telefone com DDD&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Opcional; armazenar apenas dígitos e formatação; dado pessoal LGPD.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Pessoa — telefone&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;data_nascimento&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;DATE&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#b26a00;font-weight:bold;&quot;&gt;Condicional&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Data válida e ≤ data atual&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Obrigatória para paciente; idade calculada; não pode ser futura.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Paciente — dataNascimento; Classe Pessoa — idade&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;senha_hash&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;VARCHAR(255)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Hash bcrypt ou Argon2&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; nunca armazenar senha em claro; RNF01.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Pessoa — senha; RNF01&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;nivel_permissao&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;VARCHAR(30)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Paciente | Psicologo | Atendente | Administrador&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; CHECK; define autorização por perfil.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Pessoa — nivelPermissao; RF01&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;ativo&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BOOLEAN&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;TRUE | FALSE&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; DEFAULT TRUE; bloqueio de usuários.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Pessoa; RF01; função bloquearUsuarios&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;criado_em&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TIMESTAMP&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Data e hora&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; DEFAULT now(); auditoria.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Requisito de auditoria; Modelo de Persistência&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;atualizado_em&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TIMESTAMP&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Data e hora&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Atualizado em cada alteração; auditoria.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Requisito de auditoria; Modelo de Persistência&lt;/td&gt;   &lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;shadow=0;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="60" y="150" width="1780" height="820" as="geometry"/>
                </mxCell>
                <mxCell id="dd-pessoa-notes" value="&lt;b&gt;Notas da entidade&lt;/b&gt;&lt;br&gt;&lt;br&gt;• A classe &lt;b&gt;Pessoa&lt;/b&gt; concentra os dados comuns a todos os usuários.&lt;br&gt;• O atributo &lt;b&gt;idade&lt;/b&gt; do diagrama de classes é derivado de &lt;b&gt;data_nascimento&lt;/b&gt; e não é persistido.&lt;br&gt;• O atributo &lt;b&gt;senha&lt;/b&gt; é armazenado apenas como &lt;b&gt;senha_hash&lt;/b&gt;, nunca em texto claro (RNF01)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;shadow=0;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1000" width="1780" height="160" as="geometry"/>
