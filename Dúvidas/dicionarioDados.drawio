rd-wrap:break-word;&quot;&gt;Classe Prontuário; RF04&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;descricao&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TEXT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Texto clínico&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Acesso exclusivo ao psicólogo responsável; criptografar em repouso; RN02/RNF01.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Psicólogo — prontuario; RF04&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;evolucao&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TEXT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10