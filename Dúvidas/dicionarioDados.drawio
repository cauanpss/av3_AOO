                <mxCell id="dd-agenda-table" value="&lt;table style=&quot;border-collapse:collapse;width:100%;table-layout:fixed;font-family:Helvetica,Arial,sans-serif;font-size:10.5px;background:#ffffff;&quot;&gt;&lt;tr style=&quot;background:#d5e8d4;color:#2d4a2b;font-weight:bold;&quot;&gt;     &lt;td colspan=&quot;6&quot; style=&quot;padding:7px 8px;border-bottom:1px solid #82b366;font-size:15px;&quot;&gt;Entidade: agenda&lt;/td&gt;   &lt;/tr&gt;&lt;tr style=&quot;background:#f5f8fc;color:#555;font-size:10px;font-weight:bold;&quot;&gt;     &lt;td style=&quot;padding:4px 6px;border-bottom:1px solid #d0d7de;width:180px;&quot;&gt;Atributo&lt;/td&gt;     &lt;td style=&quot;padding:4px 6px;border-bottom:1px solid #d0d7de;width:170px;&quot;&gt;Tipo&lt;/td&gt;     &lt;td style=&quot;padding:4px 6px;border-bottom:1px solid #d0d7de;width:110px;&quot;&gt;Obrigatoriedade&lt;/td&gt;     &lt;td style=&quot;padding:4px 6px;border-bottom:1px solid #d0d7de;width:300px;&quot;&gt;Domínio&lt;/td&gt;     &lt;td style=&quot;padding:4px 6px;border-bottom:1px solid #d0d7de;width:540px;&quot;&gt;Regras&lt;/td&gt;     &lt;td style=&quot;padding:4px 6px;border-bottom:1px solid #d0d7de;width:480px;&quot;&gt;Origem&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;id_agenda&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BIGSERIAL&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Inteiro positivo&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;PK; autoincremento; índice primário.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Agenda; Modelo de Persistência&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;id_psicologo&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BIGINT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;psicologo.id_pessoa&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;FK → psicologo; NOT NULL; psicólogo ativo; ON DELETE RESTRICT.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Agenda; UC Gerenciar perfil profissional&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;data&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;DATE&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Data válida&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; para novos registros, data ≥ hoje; RN03.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Agenda — data; RF02&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;horario&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TIME&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Hora no formato HH:MM&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; dentro da faixa de atendimento; UNIQUE com psicólogo e data; RN03.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Agenda — horario; RF02&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;disponibilidade&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BOOLEAN&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;TRUE | FALSE&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; DEFAULT TRUE; TRUE = livre; FALSE = ocupado/bloqueado.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Agenda — disponibilidade; RF02&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;criado_em&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TIMESTAMP&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Data e hora&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; DEFAULT now(); auditoria.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Requisito de auditoria; Modelo de Persistência&lt;/td&gt;   &lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;shadow=0;strokeColor=#82b366;" vertex="1" parent="1">
