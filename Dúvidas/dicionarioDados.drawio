&gt;Inteiro positivo&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;PK; autoincremento; índice primário.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Consulta; Modelo de Persistência&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;id_paciente&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BIGINT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;paciente.id_pessoa&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;FK → paciente; NOT NULL; paciente ativo; ON DELETE RESTRICT.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Consulta — cliente; UC Marcar consulta&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;id_psicologo&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BIGINT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;psicologo.id_pessoa&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;FK → psicologo; NOT NULL; psicólogo ativo; ON DELETE RESTRICT.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Consulta — psicologo; UC Marcar consulta&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;id_agenda&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BIGINT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;agenda.id_agenda&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;FK → agenda; UNIQUE; NOT NULL; agenda disponível; RN03.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Consulta; Classe Agenda; RF03&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;id_atendente&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;BIGINT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;atendente.id_pessoa&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;FK → atendente; opcional; preenchido quando o agendamento é feito por atendente; ON DELETE SET NULL.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Consulta; UC Atendente — Marcar consulta&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;status&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;VARCHAR(30)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#2d6a2d;font-weight:bold;&quot;&gt;Sim&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Solicitada | Agendada | Confirmada | Em Atendimento | Realizada | Cancelada | Não Compareceu&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;NOT NULL; CHECK; DEFAULT Solicitada; transições da máquina de estados.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Máquina de Estados; RF03; RN01&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;observacoes&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TEXT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Texto livre até 2.000 caracteres&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Apenas informações administrativas; não armazenar conteúdo clínico sigiloso.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Consulta — dados; RF03&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #