                <mxCell id="dd-index-summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;shadow=0;" value="&lt;b&gt;Resumo do dicionário&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;8 entidades&lt;/b&gt; e &lt;b&gt;47 atributos&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;5 requisitos funcionais&lt;/b&gt; (RF01–RF05).&lt;br&gt;• &lt;b&gt;4 requisitos não funcionais&lt;/b&gt; (RNF01–RNF04).&lt;br&gt;• &lt;b&gt;3 regras de negócio&lt;/b&gt; (RN01–RN03).&lt;br&gt;• Fontes: classes, persistência, UCDs, máquina de estados e PDFs de requisitos." vertex="1">
                    <mxGeometry height="150" width="620" x="70" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="dd-index-legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;shadow=0;" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Obrigatoriedade:&lt;/b&gt; Sim, Não ou Condicional.&lt;br&gt;• &lt;b&gt;PK / FK / PK·FK:&lt;/b&gt; chaves primária e estrangeira.&lt;br&gt;• &lt;b&gt;Domínio:&lt;/b&gt; valores permitidos e formato.&lt;br&gt;• &lt;b&gt;Regras:&lt;/b&gt; constraints, políticas e regras de negócio.&lt;br&gt;• &lt;b&gt;Origem:&lt;/b&gt; artefato que motivou o atributo.&lt;br&gt;• Clique em uma entidade para abrir a página detalhada." vertex="1">
                    <mxGeometry height="150" width="1080" x="720" y="120" as="geometry"/>
