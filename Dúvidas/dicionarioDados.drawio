nteiro positivo&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;PK/FK → pessoa(id_pessoa); ON DELETE RESTRICT.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Paciente; Modelo de Persistência&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;registro_medico&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;VARCHAR(50)&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Texto de 1 a 50 caracteres&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;UNIQUE quando preenchido; identificação administrativa.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Classe Paciente — registroMedico&lt;/td&gt;   &lt;/tr&gt;&lt;tr&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#1f2937;vertical-align:top;word-wrap:break-word;&quot;&gt;observacoes&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-family:Consolas,monospace;font-size:10px;color:#444;vertical-align:top;word-wrap:break-word;&quot;&gt;TEXT&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;vertical-align:top;&quot;&gt;&lt;span style=&quot;color:#777777;font-weight:bold;&quot;&gt;Não&lt;/span&gt;&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Texto livre até 2.000 caracteres&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;Não inserir conteúdo clínico sigiloso; uso administrativo.&lt;/td&gt;     &lt;td style=&quot;padding:5px 6px;border-bottom:1px solid #e8edf3;font-size:10px;color:#333;vertical-align:top;word-wrap:break-word;&quot;&gt;UC Atualizar cadastro; RF01&lt;/td&gt;   &lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=0;spacingTop=0;shadow=0;strokeColor=#6c8ebf;" vertex="1" parent="1">
